cs/mupen64/nightly/6._M64s-and-Sidecar-Files",{"id":69,"label":35,"href":70},"mupen64-nightly-7._Piano-Roll","/docs/mupen64/nightly/7._Piano-Roll",{"id":72,"label":39,"href":73},"mupen64-nightly-8._Data-Formats","/docs/mupen64/nightly/8._Data-Formats",{"id":75,"label":43,"href":76},"mupen64-nightly-9._Lua-Scripting","/docs/mupen64/nightly/9._Lua-Scripting",{"id":78,"label":79,"icon":80,"channel":6,"href":81,"children":82},"redux-stable","SM64 Lua Redux","redux","/docs/redux/stable",[83,87,91,95,98,102],{"id":84,"label":85,"href":86},"redux-stable-1._TAS"," TAS","/docs/redux/stable/1._TAS",{"id":88,"label":89,"href":90},"redux-stable-2._Tools"," Tools","/docs/redux/stable/2._Tools",{"id":92,"label":93,"href":94},"redux-stable-3._Timer"," Timer","/docs/redux/stable/3._Timer",{"id":96,"label":23,"href":97},"redux-stable-4._Settings","/docs/redux/stable/4._Settings",{"id":99,"label":100,"href":101},"redux-stable-5._Semantic Workflow"," Semantic Workflow","/docs/redux/stable/5._Semantic%20Workflow",{"id":103,"label":104,"href":105},"redux-stable-6._Customization"," Customization","/docs/redux/stable/6._Customization",{"id":107,"label":79,"icon":80,"channel":47,"href":108,"children":109},"redux-nightly","/docs/redux/nightly",[110,113,116,119,122,125],{"id":111,"label":85,"href":112},"redux-nightly-1._TAS","/docs/redux/nightly/1._TAS",{"id":114,"label":89,"href":115},"redux-nightly-2._Tools","/docs/redux/nightly/2._Tools",{"id":117,"label":93,"href":118},"redux-nightly-3._Timer","/docs/redux/nightly/3._Timer",{"id":120,"label":23,"href":121},"redux-nightly-4._Settings","/docs/redux/nightly/4._Settings",{"id":123,"label":100,"href":124},"redux-nightly-5._Semantic Workflow","/docs/redux/nightly/5._Semantic%20Workflow",{"id":126,"label":104,"href":127},"redux-nightly-6._Customization","/docs/redux/nightly/6._Customization"],"uses":{}},{"type":"data","data":[{"product":1,"product_label":2,"channel":3,"channel_links":4,"content":11,"title":12},"mupen64","Mupen64","nightly",[5,9],{"channel":6,"href":7,"available":8},"stable","/docs/mupen64/stable/4._Settings",true,{"channel":3,"href":10,"available":8},"/docs/mupen64/nightly/4._Settings","\u003Cblockquote>\n\u003Cp class=\"my-2\">\u003Cdiv class=\"note\">\nThis documentation page is \u003Cstrong>incomplete\u003C/strong>.\u003C/p>\n\u003Cp class=\"my-2\">Feel free to contribute by \u003Ca class=\"app-link\" href=\"https://github.com/mupen64/mupen64-rr-lua\">expanding it\u003C/a>.\u003C/p>\n\u003C/blockquote>\n\u003Cp class=\"my-2\">This page contains a breakdown of all settings available in Mupen64.\u003C/p>\n\u003Ch1 id=\"interface\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">Interface \u003Ca class=\"doc-heading-link\" href=\"#interface\" title=\"Copy link to heading\" aria-label=\"Copy link to “Interface” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Ch2 id=\"pause-when-unfocused\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Pause when unfocused \u003Ca class=\"doc-heading-link\" href=\"#pause-when-unfocused\" title=\"Copy link to heading\" aria-label=\"Copy link to “Pause when unfocused” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Pauses emulation when the main window isn&#39;t in focus.\u003C/p>\n\u003Ch2 id=\"lua-presenter\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Lua Presenter \u003Ca class=\"doc-heading-link\" href=\"#lua-presenter\" title=\"Copy link to heading\" aria-label=\"Copy link to “Lua Presenter” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">The presenter implementation used for displaying and capturing Lua graphics.\u003C/p>\n\u003Ch3 id=\"directcomposition-default\" class=\"doc-heading scroll-mt-24 my-2 text-xl\">DirectComposition (default) \u003Ca class=\"doc-heading-link\" href=\"#directcomposition-default\" title=\"Copy link to heading\" aria-label=\"Copy link to “DirectComposition (default)” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h3>\n\u003Cp class=\"my-2\">Uses \u003Ca class=\"app-link\" href=\"https://learn.microsoft.com/en-us/windows/win32/directcomp/directcomposition-portal\">DirectComposition\u003C/a> to composite Lua graphics to the screen. This approach allows true transparency and has excellent performance characteristics.\u003C/p>\n\u003Ch3 id=\"gdi\" class=\"doc-heading scroll-mt-24 my-2 text-xl\">GDI \u003Ca class=\"doc-heading-link\" href=\"#gdi\" title=\"Copy link to heading\" aria-label=\"Copy link to “GDI” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h3>\n\u003Cp class=\"my-2\">Uses GDI to composite Lua graphics to the screen. This option is only offered for compatibility purposes, as it has undesirable performance characteristics and limited functionality.\u003C/p>\n\u003Ch2 id=\"silent-mode\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Silent Mode \u003Ca class=\"doc-heading-link\" href=\"#silent-mode\" title=\"Copy link to heading\" aria-label=\"Copy link to “Silent Mode” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Suppresses all modal dialogs while choosing reasonable defaults on multi-choice ones.\u003C/p>\n\u003Cp class=\"my-2\">Recommended in automation scenarios, such as encoding bots.\u003C/p>\n\u003Ch2 id=\"keep-working-directory\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Keep working directory \u003Ca class=\"doc-heading-link\" href=\"#keep-working-directory\" title=\"Copy link to heading\" aria-label=\"Copy link to “Keep working directory” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Keeps the working directory specified by the calling program at startup.\u003C/p>\n\u003Cp class=\"my-2\">When disabled, the working directory is set to the executable&#39;s containing folder at startup.\u003C/p>\n\u003Ch2 id=\"use-async-executor\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Use Async Executor \u003Ca class=\"doc-heading-link\" href=\"#use-async-executor\" title=\"Copy link to heading\" aria-label=\"Copy link to “Use Async Executor” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Uses the new task queue-based Async Executor implementation.\u003C/p>\n\u003Cp class=\"my-2\">On - Lower interaction latency, longer queue processing times when actions are spammed\nOff - Higher interaction latency\u003C/p>\n\u003Ch1 id=\"statusbar\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">Statusbar \u003Ca class=\"doc-heading-link\" href=\"#statusbar\" title=\"Copy link to heading\" aria-label=\"Copy link to “Statusbar” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Ch2 id=\"zero-index\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Zero-index \u003Ca class=\"doc-heading-link\" href=\"#zero-index\" title=\"Copy link to heading\" aria-label=\"Copy link to “Zero-index” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">This option is only kept around for powerusers. Note that the indicies disabled when it&#39;s enabled don&#39;t represent the real state of the VCR engine and may cause confusion when combined with other tools, such as the Piano Roll.\u003C/p>\n\u003Cp class=\"my-2\">Shows indicies in the statusbar in the statusbar relative to 0 instead of 1.\u003C/p>\n\u003Ch2 id=\"scale-down-to-fit-window\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Scale down to fit window \u003Ca class=\"doc-heading-link\" href=\"#scale-down-to-fit-window\" title=\"Copy link to heading\" aria-label=\"Copy link to “Scale down to fit window” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Allows the statusbar to scale down its segments to fit inside the window.\u003C/p>\n\u003Ch2 id=\"scale-up-to-fill-window\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Scale up to fill window \u003Ca class=\"doc-heading-link\" href=\"#scale-up-to-fill-window\" title=\"Copy link to heading\" aria-label=\"Copy link to “Scale up to fill window” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Allows the statusbar to scale up its segments to fill the window.\u003C/p>\n"," Settings"],"uses":{"params":["product","channel","slug"]}}]}
