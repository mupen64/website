cs/mupen64/nightly/6._M64s-and-Sidecar-Files",{"id":69,"label":35,"href":70},"mupen64-nightly-7._Piano-Roll","/docs/mupen64/nightly/7._Piano-Roll",{"id":72,"label":39,"href":73},"mupen64-nightly-8._Data-Formats","/docs/mupen64/nightly/8._Data-Formats",{"id":75,"label":43,"href":76},"mupen64-nightly-9._Lua-Scripting","/docs/mupen64/nightly/9._Lua-Scripting",{"id":78,"label":79,"icon":80,"channel":6,"href":81,"children":82},"redux-stable","SM64 Lua Redux","redux","/docs/redux/stable",[83,87,91,95,98,102],{"id":84,"label":85,"href":86},"redux-stable-1._TAS"," TAS","/docs/redux/stable/1._TAS",{"id":88,"label":89,"href":90},"redux-stable-2._Tools"," Tools","/docs/redux/stable/2._Tools",{"id":92,"label":93,"href":94},"redux-stable-3._Timer"," Timer","/docs/redux/stable/3._Timer",{"id":96,"label":23,"href":97},"redux-stable-4._Settings","/docs/redux/stable/4._Settings",{"id":99,"label":100,"href":101},"redux-stable-5._Semantic Workflow"," Semantic Workflow","/docs/redux/stable/5._Semantic%20Workflow",{"id":103,"label":104,"href":105},"redux-stable-6._Customization"," Customization","/docs/redux/stable/6._Customization",{"id":107,"label":79,"icon":80,"channel":47,"href":108,"children":109},"redux-nightly","/docs/redux/nightly",[110,113,116,119,122,125],{"id":111,"label":85,"href":112},"redux-nightly-1._TAS","/docs/redux/nightly/1._TAS",{"id":114,"label":89,"href":115},"redux-nightly-2._Tools","/docs/redux/nightly/2._Tools",{"id":117,"label":93,"href":118},"redux-nightly-3._Timer","/docs/redux/nightly/3._Timer",{"id":120,"label":23,"href":121},"redux-nightly-4._Settings","/docs/redux/nightly/4._Settings",{"id":123,"label":100,"href":124},"redux-nightly-5._Semantic Workflow","/docs/redux/nightly/5._Semantic%20Workflow",{"id":126,"label":104,"href":127},"redux-nightly-6._Customization","/docs/redux/nightly/6._Customization"],"uses":{}},{"type":"data","data":[{"product":1,"product_label":2,"channel":3,"channel_links":4,"content":11,"title":12},"mupen64","Mupen64","nightly",[5,9],{"channel":6,"href":7,"available":8},"stable","/docs/mupen64/stable/2._FAQ",true,{"channel":3,"href":10,"available":8},"/docs/mupen64/nightly/2._FAQ","\u003Cp class=\"my-2\">Here you can find frequently asked questions about Mupen64 and its components.\u003C/p>\n\u003Ch1 id=\"general\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">General \u003Ca class=\"doc-heading-link\" href=\"#general\" title=\"Copy link to heading\" aria-label=\"Copy link to “General” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Cp class=\"my-2\">\u003Cstrong>Q: How do I frame advance backwards?\u003C/strong>\u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>A:\u003C/strong> Press \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">Ctrl + \\\u003C/code>. A movie must be active in order to do this.\u003C/p>\n\u003Cp class=\"my-2\">By default, this will trigger &quot;Multi-Frame Advance&quot; with the current advance index, which is -1 (one frame back).\u003C/p>\n\u003Cp class=\"my-2\">If you&#39;ve changed the Multi-Frame Advance index to a different value (as indicated by the \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">MFA [n]x\u003C/code> section in the status bar), pressing \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">Ctrl + \\\u003C/code> will trigger &quot;Multi-Frame Advance&quot; with that value instead.\u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>Q: Why is Fast Forward not going above 60 FPS?\u003C/strong>\u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>A:\u003C/strong> Unless you have a really slow machine which is causing the slowness, you&#39;ve likely selected a faulty audio plugin.\u003C/p>\n\u003Cp class=\"my-2\">Verify that you aren&#39;t using shunyuan’s HLE audio plugin. If you are using another video plugin, check that no settings are enabled in the audio plugin that may indicate synchronization of the emulator to audio (e.g. &quot;Sync game to Audio&quot; in Jabo&#39;s). \u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>Q: Can I go back a frame?\u003C/strong>\u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>A:\u003C/strong> It&#39;s possible to rewind by however many frames you want during movie recording or playback.\u003C/p>\n\u003Cp class=\"my-2\">To do so, you need to enable Seek Savestates in the settings and use either the Seeker (Ctrl + G) or Multi-Frame Advance (Ctrl + \\)\u003C/p>\n\u003Ch1 id=\"piano-roll\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">Piano Roll \u003Ca class=\"doc-heading-link\" href=\"#piano-roll\" title=\"Copy link to heading\" aria-label=\"Copy link to “Piano Roll” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Cp class=\"my-2\">\u003Cstrong>Q: Why is the Piano Roll grayed out and unclickable?\u003C/strong>\u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>A:\u003C/strong> Editing functionality is only available during movie recording and when the seek savestate interval is non-0.\u003C/p>\n\u003Cp class=\"my-2\">Check the settings and change &quot;Savestate interval&quot; to something like 120 or 240.\u003C/p>\n\u003Chr>\n\u003Cp class=\"my-2\">\u003Cstrong>Q: Why can I click the Piano Roll, but not the joystick?\u003C/strong>\u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>A:\u003C/strong> Verify that you have a selection in the list. The joystick only affects selected frames and when there are none, it&#39;s grayed out.\u003C/p>\n\u003Cp class=\"my-2\">If you have a selection but the input groupbox has the caption &quot;Warping...&quot;, you will have to wait until the warp modify operation completes to apply further modifications.\u003C/p>\n\u003Chr>\n\u003Cp class=\"my-2\">\u003Cstrong>Q: Why are some clicks in the seek column being ignored?\u003C/strong>\u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>A:\u003C/strong> If more than one controller is active, the Piano Roll may behave weirdly due to it not having dedicated columns for each controller.\u003C/p>\n\u003Cp class=\"my-2\">Editing multicontroller movies is possible because all controllers&#39; input are flattened into the Piano Roll, but comes with confusing drawbacks such as the playhead being limited to multiples of the controller count.\u003C/p>\n"," FAQ"],"uses":{"params":["product","channel","slug"]}}]}
