cs/mupen64/nightly/6._M64s-and-Sidecar-Files",{"id":69,"label":35,"href":70},"mupen64-nightly-7._Piano-Roll","/docs/mupen64/nightly/7._Piano-Roll",{"id":72,"label":39,"href":73},"mupen64-nightly-8._Data-Formats","/docs/mupen64/nightly/8._Data-Formats",{"id":75,"label":43,"href":76},"mupen64-nightly-9._Lua-Scripting","/docs/mupen64/nightly/9._Lua-Scripting",{"id":78,"label":79,"icon":80,"channel":6,"href":81,"children":82},"redux-stable","SM64 Lua Redux","redux","/docs/redux/stable",[83,87,91,95,98,102],{"id":84,"label":85,"href":86},"redux-stable-1._TAS"," TAS","/docs/redux/stable/1._TAS",{"id":88,"label":89,"href":90},"redux-stable-2._Tools"," Tools","/docs/redux/stable/2._Tools",{"id":92,"label":93,"href":94},"redux-stable-3._Timer"," Timer","/docs/redux/stable/3._Timer",{"id":96,"label":23,"href":97},"redux-stable-4._Settings","/docs/redux/stable/4._Settings",{"id":99,"label":100,"href":101},"redux-stable-5._Semantic Workflow"," Semantic Workflow","/docs/redux/stable/5._Semantic%20Workflow",{"id":103,"label":104,"href":105},"redux-stable-6._Customization"," Customization","/docs/redux/stable/6._Customization",{"id":107,"label":79,"icon":80,"channel":47,"href":108,"children":109},"redux-nightly","/docs/redux/nightly",[110,113,116,119,122,125],{"id":111,"label":85,"href":112},"redux-nightly-1._TAS","/docs/redux/nightly/1._TAS",{"id":114,"label":89,"href":115},"redux-nightly-2._Tools","/docs/redux/nightly/2._Tools",{"id":117,"label":93,"href":118},"redux-nightly-3._Timer","/docs/redux/nightly/3._Timer",{"id":120,"label":23,"href":121},"redux-nightly-4._Settings","/docs/redux/nightly/4._Settings",{"id":123,"label":100,"href":124},"redux-nightly-5._Semantic Workflow","/docs/redux/nightly/5._Semantic%20Workflow",{"id":126,"label":104,"href":127},"redux-nightly-6._Customization","/docs/redux/nightly/6._Customization"],"uses":{}},{"type":"data","data":[{"product":1,"product_label":2,"channel":3,"channel_links":4,"content":11,"title":12},"mupen64","Mupen64","stable",[5,8],{"channel":3,"href":6,"available":7},"/docs/mupen64/stable/9._Lua-Scripting",true,{"channel":9,"href":10,"available":7},"nightly","/docs/mupen64/nightly/9._Lua-Scripting","\u003Ch1 id=\"api-definition-setup\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">API Definition Setup \u003Ca class=\"doc-heading-link\" href=\"#api-definition-setup\" title=\"Copy link to heading\" aria-label=\"Copy link to “API Definition Setup” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Cp class=\"my-2\">To get started with Lua scripting in Mupen64, you should set up your project to use the API definitions.\u003C/p>\n\u003Cp class=\"my-2\">You can find the API definitions as \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">api.lua\u003C/code> in the repack.\u003C/p>\n\u003Col class=\"ol\">\n\u003Cli>Create a \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">./lib\u003C/code> directory at the root of your project\u003C/li>\n\u003Cli>Copy \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">api.lua\u003C/code> into \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">./lib\u003C/code>\u003C/li>\n\u003Cli>Add \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">lib\u003C/code> to \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">workspace.library\u003C/code> in your \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">.luarc\u003C/code> config at the root of your project\u003C/li>\n\u003C/ol>\n\u003Cp class=\"my-2\">Most IDEs should now automatically recognize the API definitions and provide code completion and type checking.\u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>It&#39;s not necessary to \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">require\u003C/code> or \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">dofile\u003C/code> the API definitions in your scripts; Mupen has its own internal copy that&#39;s automatically loaded.\u003C/strong>\u003C/p>\n\u003Cp class=\"my-2\">\u003Cstrong>Make sure to update the \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">api.lua\u003C/code> file in your \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">./lib\u003C/code> directory whenever you update Mupen64.\u003C/strong>\u003C/p>\n"," Lua Scripting"],"uses":{"params":["product","channel","slug"]}}]}
