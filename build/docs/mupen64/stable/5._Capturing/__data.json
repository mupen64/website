{"type":"data","nodes":[null,{"type":"data","data":[{"docs_tree":1},[2,45,77,106],{"id":3,"label":4,"icon":5,"channel":6,"href":7,"children":8},"mupen64-stable","Mupen64","mupen64","stable","/docs/mupen64/stable",[9,13,17,21,25,29,33,37,41],{"id":10,"label":11,"href":12},"mupen64-stable-1._Getting_Started"," Getting Started","/docs/mupen64/stable/1._Getting_Started",{"id":14,"label":15,"href":16},"mupen64-stable-2._FAQ"," FAQ","/docs/mupen64/stable/2._FAQ",{"id":18,"label":19,"href":20},"mupen64-stable-3._Actions"," Actions","/docs/mupen64/stable/3._Actions",{"id":22,"label":23,"href":24},"mupen64-stable-4._Settings"," Settings","/docs/mupen64/stable/4._Settings",{"id":26,"label":27,"href":28},"mupen64-stable-5._Capturing"," Capturing","/docs/mupen64/stable/5._Capturing",{"id":30,"label":31,"href":32},"mupen64-stable-6._M64s-and-Sidecar-Files"," M64s and Sidecar Files","/docs/mupen64/stable/6._M64s-and-Sidecar-Files",{"id":34,"label":35,"href":36},"mupen64-stable-7._Piano-Roll"," Piano Roll","/docs/mupen64/stable/7._Piano-Roll",{"id":38,"label":39,"href":40},"mupen64-stable-8._Data-Formats"," Data Formats","/docs/mupen64/stable/8._Data-Formats",{"id":42,"label":43,"href":44},"mupen64-stable-9._Lua-Scripting"," Lua Scripting","/docs/mupen64/stable/9._Lua-Scripting",{"id":46,"label":4,"icon":5,"channel":47,"href":48,"children":49},"mupen64-nightly","nightly","/docs/mupen64/nightly",[50,53,56,59,62,65,68,71,74],{"id":51,"label":11,"href":52},"mupen64-nightly-1._Getting_Started","/docs/mupen64/nightly/1._Getting_Started",{"id":54,"label":15,"href":55},"mupen64-nightly-2._FAQ","/docs/mupen64/nightly/2._FAQ",{"id":57,"label":19,"href":58},"mupen64-nightly-3._Actions","/docs/mupen64/nightly/3._Actions",{"id":60,"label":23,"href":61},"mupen64-nightly-4._Settings","/docs/mupen64/nightly/4._Settings",{"id":63,"label":27,"href":64},"mupen64-nightly-5._Capturing","/docs/mupen64/nightly/5._Capturing",{"id":66,"label":31,"href":67},"mupen64-nightly-6._M64s-and-Sidecar-Files","/docs/mupen64/nightly/6._M64s-and-Sidecar-Files",{"id":69,"label":35,"href":70},"mupen64-nightly-7._Piano-Roll","/docs/mupen64/nightly/7._Piano-Roll",{"id":72,"label":39,"href":73},"mupen64-nightly-8._Data-Formats","/docs/mupen64/nightly/8._Data-Formats",{"id":75,"label":43,"href":76},"mupen64-nightly-9._Lua-Scripting","/docs/mupen64/nightly/9._Lua-Scripting",{"id":78,"label":79,"icon":80,"channel":6,"href":81,"children":82},"redux-stable","SM64 Lua Redux","redux","/docs/redux/stable",[83,87,91,95,98,102],{"id":84,"label":85,"href":86},"redux-stable-1._TAS"," TAS","/docs/redux/stable/1._TAS",{"id":88,"label":89,"href":90},"redux-stable-2._Tools"," Tools","/docs/redux/stable/2._Tools",{"id":92,"label":93,"href":94},"redux-stable-3._Timer"," Timer","/docs/redux/stable/3._Timer",{"id":96,"label":23,"href":97},"redux-stable-4._Settings","/docs/redux/stable/4._Settings",{"id":99,"label":100,"href":101},"redux-stable-5._Semantic Workflow"," Semantic Workflow","/docs/redux/stable/5._Semantic%20Workflow",{"id":103,"label":104,"href":105},"redux-stable-6._Customization"," Customization","/docs/redux/stable/6._Customization",{"id":107,"label":79,"icon":80,"channel":47,"href":108,"children":109},"redux-nightly","/docs/redux/nightly",[110,113,116,119,122,125],{"id":111,"label":85,"href":112},"redux-nightly-1._TAS","/docs/redux/nightly/1._TAS",{"id":114,"label":89,"href":115},"redux-nightly-2._Tools","/docs/redux/nightly/2._Tools",{"id":117,"label":93,"href":118},"redux-nightly-3._Timer","/docs/redux/nightly/3._Timer",{"id":120,"label":23,"href":121},"redux-nightly-4._Settings","/docs/redux/nightly/4._Settings",{"id":123,"label":100,"href":124},"redux-nightly-5._Semantic Workflow","/docs/redux/nightly/5._Semantic%20Workflow",{"id":126,"label":104,"href":127},"redux-nightly-6._Customization","/docs/redux/nightly/6._Customization"],"uses":{}},{"type":"data","data":[{"product":1,"product_label":2,"channel":3,"channel_links":4,"content":11,"title":12},"mupen64","Mupen64","stable",[5,8],{"channel":3,"href":6,"available":7},"/docs/mupen64/stable/5._Capturing",true,{"channel":9,"href":10,"available":7},"nightly","/docs/mupen64/nightly/5._Capturing","\u003Cp class=\"my-2\">Capturing a gameplay video using Mupen64&#39;s capture functionality is recommended\nover using external capture software such as OBS, as the video and audio streams\nare guaranteed to be steady and clean.\u003C/p>\n\u003Cp class=\"my-2\">This page details some tips for capturing.\u003C/p>\n\u003Ch1 id=\"1-choose-a-video-plugin\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">1. Choose a video plugin \u003Ca class=\"doc-heading-link\" href=\"#1-choose-a-video-plugin\" title=\"Copy link to heading\" aria-label=\"Copy link to “1. Choose a video plugin” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Cp class=\"my-2\">Unless you need special functionality from other plugins, use the bundled \u003Cstrong>TAS Video\u003C/strong> plugin - it has the best compatibility and stability for capturing.\u003C/p>\n\u003Ch1 id=\"2-encoder-setup\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">2. Encoder Setup \u003Ca class=\"doc-heading-link\" href=\"#2-encoder-setup\" title=\"Copy link to heading\" aria-label=\"Copy link to “2. Encoder Setup” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Cp class=\"my-2\">For high-performance capture, you&#39;ll want to select the FFmpeg encoder in the settings (\u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">Settings &gt; Capture &gt; Encoder\u003C/code>).\u003C/p>\n\u003Cp class=\"my-2\">By default, Mupen64 will look for FFmpeg in the \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">C:\\ffmpeg\u003C/code> directory, but this can be changed at \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">Settings &gt; Capture &gt; FFmpeg Path\u003C/code>.\u003C/p>\n\u003Cp class=\"my-2\">To install FFmpeg, download the\n\u003Ca class=\"app-link\" href=\"https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-full.7z\">latest release build\u003C/a>\nand extract it to your \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">C:\\\u003C/code> drive.\u003C/p>\n\u003Cp class=\"my-2\">If FFmpeg is still not detected by Mupen, check that the FFmpeg path in the\nMupen settings matches the path in the filesystem.\u003C/p>\n\u003Ch1 id=\"3-choose-a-mode\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">3. Choose a mode \u003Ca class=\"doc-heading-link\" href=\"#3-choose-a-mode\" title=\"Copy link to heading\" aria-label=\"Copy link to “3. Choose a mode” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Cp class=\"my-2\">It&#39;s generally recommended to only use the Hybrid capture mode, unless you have\nspecial requirements.\u003C/p>\n\u003Ch1 id=\"4-start-capture\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">4. Start Capture \u003Ca class=\"doc-heading-link\" href=\"#4-start-capture\" title=\"Copy link to heading\" aria-label=\"Copy link to “4. Start Capture” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Cp class=\"my-2\">To start a capture, invoke \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">Utilities &gt; Video Capture &gt; Start Capture...\u003C/code>.\u003C/p>\n\u003Ch1 id=\"troubleshooting\" class=\"doc-heading scroll-mt-24 my-4 text-3xl font-bold separator-below\">Troubleshooting \u003Ca class=\"doc-heading-link\" href=\"#troubleshooting\" title=\"Copy link to heading\" aria-label=\"Copy link to “Troubleshooting” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h1>\n\u003Ch2 id=\"the-recording-is-black-but-has-audio\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">The recording is black but has audio \u003Ca class=\"doc-heading-link\" href=\"#the-recording-is-black-but-has-audio\" title=\"Copy link to heading\" aria-label=\"Copy link to “The recording is black but has audio” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Check that you have selected a capture mode compatible with your use-case. It&#39;s\nrecommended to use the Hybrid capture mode.\u003C/p>\n\u003Cp class=\"my-2\">If using FFmpeg, verify that your encoding parameters are valid and accepted by\nFFmpeg by checking the debug output.\u003C/p>\n\u003Ch2 id=\"mupen-crashes-after-a-few-frames-have-gone-by\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Mupen crashes after a few frames have gone by \u003Ca class=\"doc-heading-link\" href=\"#mupen-crashes-after-a-few-frames-have-gone-by\" title=\"Copy link to heading\" aria-label=\"Copy link to “Mupen crashes after a few frames have gone by” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">If you are encoding at large resolutions using VFW, Mupen might have run out of\nmemory.\u003C/p>\n\u003Cp class=\"my-2\">Try using FFmpeg instead.\u003C/p>\n\u003Cp class=\"my-2\">If you are encoding at large resolutions using FFmpeg, the memory pressure can\nbe very high during the first 30 frames of capture, leaving Mupen to operate\nwith barely a few megabytes of memory.\u003C/p>\n\u003Cp class=\"my-2\">Avoid performing any action in the UI, such as opening dialogs or starting movie\nplayback.\u003C/p>\n\u003Ch2 id=\"i-am-getting-the-error-audio-frequency-changed-during-capture-the-capture-will-be-stopped\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">I am getting the error &quot;Audio frequency changed during capture. The capture will be stopped.&quot; \u003Ca class=\"doc-heading-link\" href=\"#i-am-getting-the-error-audio-frequency-changed-during-capture-the-capture-will-be-stopped\" title=\"Copy link to heading\" aria-label=\"Copy link to “I am getting the error &amp;quot;Audio frequency changed during capture. The capture will be stopped.&amp;quot;” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Mupen64 doesn&#39;t support resetting across ROMs during a capture. \u003C/p>\n\u003Cp class=\"my-2\">Verify that you&#39;re not starting the wrong ROM accidentally.\u003C/p>\n"," Capturing"],"uses":{"params":["product","channel","slug"]}}]}
