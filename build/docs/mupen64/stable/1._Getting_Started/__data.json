{"type":"data","nodes":[null,{"type":"data","data":[{"docs_tree":1},[2,45,77,106],{"id":3,"label":4,"icon":5,"channel":6,"href":7,"children":8},"mupen64-stable","Mupen64","mupen64","stable","/docs/mupen64/stable",[9,13,17,21,25,29,33,37,41],{"id":10,"label":11,"href":12},"mupen64-stable-1._Getting_Started"," Getting Started","/docs/mupen64/stable/1._Getting_Started",{"id":14,"label":15,"href":16},"mupen64-stable-2._FAQ"," FAQ","/docs/mupen64/stable/2._FAQ",{"id":18,"label":19,"href":20},"mupen64-stable-3._Actions"," Actions","/docs/mupen64/stable/3._Actions",{"id":22,"label":23,"href":24},"mupen64-stable-4._Settings"," Settings","/docs/mupen64/stable/4._Settings",{"id":26,"label":27,"href":28},"mupen64-stable-5._Capturing"," Capturing","/docs/mupen64/stable/5._Capturing",{"id":30,"label":31,"href":32},"mupen64-stable-6._M64s-and-Sidecar-Files"," M64s and Sidecar Files","/docs/mupen64/stable/6._M64s-and-Sidecar-Files",{"id":34,"label":35,"href":36},"mupen64-stable-7._Piano-Roll"," Piano Roll","/docs/mupen64/stable/7._Piano-Roll",{"id":38,"label":39,"href":40},"mupen64-stable-8._Data-Formats"," Data Formats","/docs/mupen64/stable/8._Data-Formats",{"id":42,"label":43,"href":44},"mupen64-stable-9._Lua-Scripting"," Lua Scripting","/docs/mupen64/stable/9._Lua-Scripting",{"id":46,"label":4,"icon":5,"channel":47,"href":48,"children":49},"mupen64-nightly","nightly","/docs/mupen64/nightly",[50,53,56,59,62,65,68,71,74],{"id":51,"label":11,"href":52},"mupen64-nightly-1._Getting_Started","/docs/mupen64/nightly/1._Getting_Started",{"id":54,"label":15,"href":55},"mupen64-nightly-2._FAQ","/docs/mupen64/nightly/2._FAQ",{"id":57,"label":19,"href":58},"mupen64-nightly-3._Actions","/docs/mupen64/nightly/3._Actions",{"id":60,"label":23,"href":61},"mupen64-nightly-4._Settings","/docs/mupen64/nightly/4._Settings",{"id":63,"label":27,"href":64},"mupen64-nightly-5._Capturing","/docs/mupen64/nightly/5._Capturing",{"id":66,"label":31,"href":67},"mupen64-nightly-6._M64s-and-Sidecar-Files","/docs/mupen64/nightly/6._M64s-and-Sidecar-Files",{"id":69,"label":35,"href":70},"mupen64-nightly-7._Piano-Roll","/docs/mupen64/nightly/7._Piano-Roll",{"id":72,"label":39,"href":73},"mupen64-nightly-8._Data-Formats","/docs/mupen64/nightly/8._Data-Formats",{"id":75,"label":43,"href":76},"mupen64-nightly-9._Lua-Scripting","/docs/mupen64/nightly/9._Lua-Scripting",{"id":78,"label":79,"icon":80,"channel":6,"href":81,"children":82},"redux-stable","SM64 Lua Redux","redux","/docs/redux/stable",[83,87,91,95,98,102],{"id":84,"label":85,"href":86},"redux-stable-1._TAS"," TAS","/docs/redux/stable/1._TAS",{"id":88,"label":89,"href":90},"redux-stable-2._Tools"," Tools","/docs/redux/stable/2._Tools",{"id":92,"label":93,"href":94},"redux-stable-3._Timer"," Timer","/docs/redux/stable/3._Timer",{"id":96,"label":23,"href":97},"redux-stable-4._Settings","/docs/redux/stable/4._Settings",{"id":99,"label":100,"href":101},"redux-stable-5._Semantic Workflow"," Semantic Workflow","/docs/redux/stable/5._Semantic%20Workflow",{"id":103,"label":104,"href":105},"redux-stable-6._Customization"," Customization","/docs/redux/stable/6._Customization",{"id":107,"label":79,"icon":80,"channel":47,"href":108,"children":109},"redux-nightly","/docs/redux/nightly",[110,113,116,119,122,125],{"id":111,"label":85,"href":112},"redux-nightly-1._TAS","/docs/redux/nightly/1._TAS",{"id":114,"label":89,"href":115},"redux-nightly-2._Tools","/docs/redux/nightly/2._Tools",{"id":117,"label":93,"href":118},"redux-nightly-3._Timer","/docs/redux/nightly/3._Timer",{"id":120,"label":23,"href":121},"redux-nightly-4._Settings","/docs/redux/nightly/4._Settings",{"id":123,"label":100,"href":124},"redux-nightly-5._Semantic Workflow","/docs/redux/nightly/5._Semantic%20Workflow",{"id":126,"label":104,"href":127},"redux-nightly-6._Customization","/docs/redux/nightly/6._Customization"],"uses":{}},{"type":"data","data":[{"product":1,"product_label":2,"channel":3,"channel_links":4,"content":11,"title":12},"mupen64","Mupen64","stable",[5,8],{"channel":3,"href":6,"available":7},"/docs/mupen64/stable/1._Getting_Started",true,{"channel":9,"href":10,"available":7},"nightly","/docs/mupen64/nightly/1._Getting_Started","\u003Cp class=\"my-2\">Get up and running with Mupen64 in minutes.\u003C/p>\n\u003Ch2 id=\"1-extract\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">1. Extract \u003Ca class=\"doc-heading-link\" href=\"#1-extract\" title=\"Copy link to heading\" aria-label=\"Copy link to “1. Extract” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Extract the downloaded ZIP file (\u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">repack-stable\u003C/code>) to a folder of your choice.\u003C/p>\n\u003Cp class=\"my-2\">\u003Cimg src=\"screenshots/extracted-folder.png\" alt=\"Extracted folder\">\u003C/p>\n\u003Cp class=\"my-2\">Open the extracted folder and navigate to \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">repack-main/stable\u003C/code>. You will see the emulator files including \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">mupen64.exe\u003C/code>.\u003C/p>\n\u003Cp class=\"my-2\">\u003Cimg src=\"screenshots/Stable-Version.png\" alt=\"Stable Version\">\u003C/p>\n\u003Ch2 id=\"2-add-roms\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">2. Add ROMs \u003Ca class=\"doc-heading-link\" href=\"#2-add-roms\" title=\"Copy link to heading\" aria-label=\"Copy link to “2. Add ROMs” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Mupen64 pulls its roms from the \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">rom\u003C/code> folder.\u003C/p>\n\u003Col class=\"ol\">\n\u003Cli>\u003Cp class=\"my-2\">Locate the \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">rom\u003C/code> folder in your Mupen64 directory.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp class=\"my-2\">Drag your \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">.n64\u003C/code>, \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">.z64\u003C/code>, or \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">.v64\u003C/code> ROM files into the \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">rom\u003C/code> folder.\u003C/p>\n\u003C/li>\n\u003Cli>\u003Cp class=\"my-2\">Mupen will list every ROM found in that folder once started.\u003C/p>\n\u003C/li>\n\u003C/ol>\n\u003Cp class=\"my-2\">\u003Cimg src=\"screenshots/move-rom.png\" alt=\"Move Rom\">\u003C/p>\n\u003Ch2 id=\"3-launch\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">3. Launch \u003Ca class=\"doc-heading-link\" href=\"#3-launch\" title=\"Copy link to heading\" aria-label=\"Copy link to “3. Launch” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">Double-click \u003Cstrong>mupen64.exe\u003C/strong> to start the emulator.\u003C/p>\n\u003Cp class=\"my-2\">\u003Cimg src=\"screenshots/rom-list.png\" alt=\"ROM list\">\u003C/p>\n\u003Cp class=\"my-2\">When it has started, double-click a game to load it. The TAS Input window appears alongside the game.\u003C/p>\n\u003Ch2 id=\"4-sm64-lua-redux-optional\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">4. SM64 Lua Redux (Optional) \u003Ca class=\"doc-heading-link\" href=\"#4-sm64-lua-redux-optional\" title=\"Copy link to heading\" aria-label=\"Copy link to “4. SM64 Lua Redux (Optional)” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Cp class=\"my-2\">If you&#39;re TASing Super Mario 64, you can use SM64 Lua Redux to visualize data and guide your inputs.\u003C/p>\n\u003Ch3 id=\"41-add-the-script\" class=\"doc-heading scroll-mt-24 my-2 text-xl\">4.1 Add the Script \u003Ca class=\"doc-heading-link\" href=\"#41-add-the-script\" title=\"Copy link to heading\" aria-label=\"Copy link to “4.1 Add the Script” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h3>\n\u003Cp class=\"my-2\">You can use scripts:\u003C/p>\n\u003Cp class=\"my-2\">drag and drop \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">SM64Lua.lua\u003C/code> directly from the \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">SM64LuaRedux/src\u003C/code> folder onto the Mupen64 window.\u003C/p>\n\u003Cp class=\"my-2\">\u003Cimg src=\"screenshots/drag-drop-lua-script.png\" alt=\"Drag and drop Lua script\">\u003C/p>\n\u003Cp class=\"my-2\">The overlay now displays live game data on the right side of the game window.\u003C/p>\n\u003Cp class=\"my-2\">\u003Cimg src=\"screenshots/lua-active.png\" alt=\"SM64 Lua Redux active\">\u003C/p>\n\u003Ch2 id=\"common-keyboard-shortcuts\" class=\"doc-heading scroll-mt-24 my-3 text-2xl\">Common Keyboard Shortcuts \u003Ca class=\"doc-heading-link\" href=\"#common-keyboard-shortcuts\" title=\"Copy link to heading\" aria-label=\"Copy link to “Common Keyboard Shortcuts” heading\">\u003Csvg xmlns=\"http://www.w3.org/2000/svg\" fill=\"none\" viewBox=\"0 0 24 24\" stroke-width=\"1.5\" stroke=\"currentColor\" aria-hidden=\"true\">\u003Cpath stroke-linecap=\"round\" stroke-linejoin=\"round\" d=\"M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244\"/>\u003C/svg>\u003C/a>\u003C/h2>\n\u003Ctable class=\"doc-table\">\n\u003Cthead>\n\u003Ctr>\n\u003Cth>Key\u003C/th>\n\u003Cth>Action\u003C/th>\n\u003C/tr>\n\u003C/thead>\n\u003Ctbody>\u003Ctr>\n\u003Ctd>\u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">Ctrl + O\u003C/code>\u003C/td>\n\u003Ctd>Load ROM\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">Ctrl + S\u003C/code>\u003C/td>\n\u003Ctd>Settings\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">Ctrl + N\u003C/code>\u003C/td>\n\u003Ctd>Show Lua Instances\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">F1\u003C/code> - \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">F10\u003C/code>\u003C/td>\n\u003Ctd>Save state to slot 1-10\u003C/td>\n\u003C/tr>\n\u003Ctr>\n\u003Ctd>\u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">Shift + F1\u003C/code> - \u003Ccode class=\"rounded bg-slate-200 px-1 py-0.5 font-mono text-[0.95em] dark:bg-slate-700/80\">F10\u003C/code>\u003C/td>\n\u003Ctd>Load state from slot 1-10\u003C/td>\n\u003C/tr>\n\u003C/tbody>\u003C/table>\n\u003Cp class=\"my-2\">You&#39;re now ready to use Mupen64&#39;s TAS capabilities.\u003C/p>\n\u003Cp class=\"my-2\">Please note that the Mupen64 ecosystem is geared towards Super Mario 64 and its romhacks - other games might not be emulated accurately.\u003C/p>\n\u003Cp class=\"my-2\">To learn more, join the \u003Ca class=\"app-link\" href=\"https://discord.gg/hFANcme32k\">Mupen64 Discord Server\u003C/a>.\u003C/p>\n"," Getting Started"],"uses":{"params":["product","channel","slug"]}}]}
